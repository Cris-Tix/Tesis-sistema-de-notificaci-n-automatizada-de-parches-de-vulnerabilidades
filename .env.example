# =============================================================================
# VulnPatchNotifier — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (it is listed in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# Host must match the Docker Compose service name when running inside the stack.
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vulnerability_mgmt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=XXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# n8n
# N8N_HOST: the hostname/IP n8n is reachable at (used for webhook URLs).
# Use "localhost" for local development. Use your public domain in production.
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Public-facing webhook base URL (used by n8n to build webhook callback URLs)
N8N_WEBHOOK_URL=http://localhost:5678/

# n8n basic-auth credentials for the web UI
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=XXXXXXXXXXXXXXXX

# Timezone (IANA tz name). All SLA deadlines and cron triggers use this.
GENERIC_TIMEZONE=UTC
TZ=UTC

# -----------------------------------------------------------------------------
# External API Keys
# -----------------------------------------------------------------------------

# NVD API key — obtain at https://nvd.nist.gov/developers/request-an-api-key
# Without a key requests are rate-limited to 5 req/30s; with key: 50 req/30s.
NVD_API_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Shodan API key — obtain at https://account.shodan.io/
SHODAN_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# SMTP — outbound email for security alerts
# Example below uses Gmail SMTP with App Password.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASSWORD=XXXX XXXX XXXX XXXX

# Destination address for security alert emails
SECURITY_TEAM_EMAIL=security@example.com

# -----------------------------------------------------------------------------
# Slack Webhooks
# Create incoming webhooks at https://api.slack.com/apps
# -----------------------------------------------------------------------------

# Primary channel for new vulnerability alerts (e.g. #security-alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX

# Escalation channel for overdue SLA re-notifications (e.g. #security-escalation)
SLACK_WEBHOOK_ESCALATION=https://hooks.slack.com/services/XXXXXXXXX/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# CISA KEV Catalog
# The feed is downloaded once per day and cached. Adjust TTL if needed.
# -----------------------------------------------------------------------------
CISA_KEV_CACHE_TTL_HOURS=24